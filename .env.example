# Скопируйте этот файл в .env и укажите токены ботов и ID каналов.
# Никогда не добавляйте .env в Git и не публикуйте токены ботов.

# =========================
# Discord-бот
# =========================
DISCORD_BOT_TOKEN=
# Необязательно: ID Discord-сервера. Ограничивает поиск голосового канала этим сервером и проверяет, что бот на нём присутствует.
# Если не указан, канал ищется среди всех серверов, доступных боту.
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
# Необязательно: текстовый канал Discord для событий входа/выхода из голосовых каналов обеих платформ.
DISCORD_LOG_CHANNEL_ID=

# =========================
# Бот Lolka
# =========================
LOLKA_BOT_TOKEN=
# Необязательно: ID сервера Lolka. Ограничивает поиск голосового канала этим сервером и проверяет, что бот на нём присутствует.
# Если не указан, канал ищется среди всех серверов, доступных боту.
LOLKA_GUILD_ID=
LOLKA_VOICE_CHANNEL_ID=
# Необязательно: текстовый канал Lolka для событий входа/выхода из голосовых каналов обеих платформ.
LOLKA_LOG_CHANNEL_ID=

# =========================
# Общие настройки
# =========================
COMMAND_PREFIX=!

# Необязательно: заменить воспроизведение диагностическим тоном 440 Гц (true/false).
DIAGNOSTIC_TONE=false
