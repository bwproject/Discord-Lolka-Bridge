# Copy this file to .env and fill in your private bot tokens and channel IDs.
# Never commit .env or share bot tokens publicly.

# =========================
# Discord bot
# =========================
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_VOICE_CHANNEL_ID=
# Optional: Discord text channel for voice join/leave events from both platforms.
DISCORD_LOG_CHANNEL_ID=

# =========================
# Lolka bot
# =========================
LOLKA_BOT_TOKEN=
LOLKA_GUILD_ID=
LOLKA_VOICE_CHANNEL_ID=
# Optional: Lolka text channel for voice join/leave events from both platforms.
LOLKA_LOG_CHANNEL_ID=

# =========================
# Shared settings
# =========================
COMMAND_PREFIX=!

# Optional: replace playback with a 440 Hz diagnostic tone (true/false).
DIAGNOSTIC_TONE=false
